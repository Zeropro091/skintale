{
  "name": "facewish",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "seed": "node --env-file-if-exists=.env --import tsx apps/api/src/db/seed.ts",
    "db:inspect": "node --import tsx scripts/inspect-db.ts",
    "ui:test": "node scripts/ui-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "playwright-core": "^1.64.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "multer": "^1.4.4",
    "zod": "^4.6.7"
  }
}
