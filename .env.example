# Copy to .env. Config is parsed with Zod at boot; a missing required value crashes fast.
NODE_ENV=development
DATABASE_URL=postgres://facewish:facewish@localhost:5432/facewish
SESSION_SECRET=change-me-32-chars-minimum-000000
WEB_ORIGIN=http://localhost:5173

# vision: "stub" only allowed when NODE_ENV != production
VISION_PROVIDER=stub
VISION_API_KEY=
VISION_MODEL=

LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=

STORAGE_DRIVER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

RATE_LIMIT_SCANS_PER_HOUR=10
RATE_LIMIT_CHATS_PER_HOUR=30
