# Copy to .env. Config is parsed with Zod at boot; a missing required value crashes fast.
NODE_ENV=development
# Postgres is the production target; local dev and tests use node:sqlite at DB_PATH.
# DATABASE_URL=postgres://user:pass@localhost:5432/facewish
SESSION_SECRET=change-me-32-chars-minimum-000000
PORT=3000
DB_PATH=data/facewish.db

# vision: "gemini" (Google AI Studio), "openai-compatible", or "stub".
# "stub" is refused when NODE_ENV=production — it invents valid-looking, meaningless numbers.
VISION_PROVIDER=gemini
VISION_MODEL=gemini-2.5-flash
VISION_API_KEY=
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# VISION_TIMEOUT_MS=30000

LLM_PROVIDER=none
LLM_BASE_URL=https://openagentic.id/v1
LLM_API_KEY=
LLM_MODEL=

STORAGE_DRIVER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

RATE_LIMIT_SCANS_PER_HOUR=10
RATE_LIMIT_CHATS_PER_HOUR=30
